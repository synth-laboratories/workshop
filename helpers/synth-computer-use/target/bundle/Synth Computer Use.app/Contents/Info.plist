<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>synth-computer-use</string>

	<!-- Stable across versions on purpose. This is half the code identity TCC
	     remembers, so changing it silently revokes every grant the operator
	     has already given and they have to grant them all again. -->
	<key>CFBundleIdentifier</key>
	<string>ai.usesynth.workshop.ComputerUseHelper</string>

	<key>CFBundleName</key>
	<string>Synth Computer Use</string>
	<key>CFBundleDisplayName</key>
	<string>Synth Computer Use</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>

	<!-- No Dock icon, no menu bar. The helper is machinery, and an agent
	     driving apps in the background should not put a second application in
	     the operator's Cmd-Tab list. -->
	<key>LSUIElement</key>
	<true/>

	<!-- Shown verbatim in the system permission prompts, so these are written
	     for the operator reading a dialog, not for us. -->
	<key>NSAccessibilityUsageDescription</key>
	<string>Synth Workshop uses accessibility to read window contents and send clicks and keystrokes to the apps you allow.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Synth Workshop asks each app for permission the first time an agent drives it.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Synth Workshop captures the app you are driving so each action has a before and after image.</string>
</dict>
</plist>
