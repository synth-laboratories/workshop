{
  "schemaVersion": "synth.visual-template.v1",
  "id": "live.intern_acceptance.v1",
  "title": "Intern acceptance stream",
  "genre": "live",
  "version": "1.0.0",
  "description": "Intern sync/async acceptance cell stream for research factory gates.",
  "accent": "#FF5C00",
  "shell": "shell.tsx",
  "tags": [
    "live",
    "intern",
    "acceptance",
    "sync",
    "async"
  ],
  "observationContract": {
    "schemaVersion": "synth.visual-observation-contract.v1",
    "readiness": {
      "rejectTransportStates": [
        "idle",
        "declared",
        "replaying",
        "error",
        "connecting",
        "reconnecting"
      ],
      "minimumRolloutCount": 0,
      "minimumRenderedFrameCount": 0,
      "minimumSemanticEventCount": 1,
      "minimumTransportEnvelopeCount": 1,
      "requireTerminal": false
    }
  },
  "inputs": [
    {
      "name": "acceptance",
      "description": "Live SSE or fixture with acceptance / cell decisions",
      "accepts": [
        "live_sse",
        "fixture",
        "inline"
      ],
      "required": true,
      "schema": "synth.visual.live_eval_events.v1"
    }
  ]
}
