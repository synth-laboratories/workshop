{
  "schemaVersion": "synth.visual-template.v1",
  "id": "optimizer.sft.rollouts.v1",
  "title": "SFT rollouts",
  "genre": "optimizer",
  "version": "1.0.0",
  "description": "SFT campaign child rollout resource-refs. Not sparse metric arrays as lanes.",
  "accent": "#F05F22",
  "shell": "shell.tsx",
  "tags": [
    "optimizer",
    "sft",
    "rollouts"
  ],
  "observationContract": {
    "schemaVersion": "synth.visual-observation-contract.v1",
    "readiness": {
      "rejectTransportStates": [
        "idle",
        "declared",
        "replaying",
        "error",
        "connecting",
        "reconnecting"
      ],
      "minimumRolloutCount": 0,
      "minimumRenderedFrameCount": 0,
      "minimumSemanticEventCount": 1,
      "requireTerminal": true
    }
  },
  "inputs": [
    {
      "name": "optimizer_run",
      "description": "Optimizer run + campaign child container_rollout refs",
      "accepts": [
        "optimizer_run",
        "fixture",
        "inline"
      ],
      "required": true,
      "schema": "optimizer_event.v1"
    }
  ]
}
