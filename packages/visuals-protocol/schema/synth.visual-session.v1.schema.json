{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synth:visual-session:v1",
  "title": "Visual session, checkpoint and recording protocol",
  "oneOf": [{"$ref":"#/$defs/state"},{"$ref":"#/$defs/checkpoint"},{"$ref":"#/$defs/recording"}],
  "$defs": {
    "valueSchema": {
      "type":"object","required":["type"],
      "properties": {
        "type":{"enum":["string","number","boolean","object","array","null"]},
        "nullable":{"type":"boolean"},"options":{"type":"array"},
        "oneOf":{"type":"array","minItems":1,"maxItems":16,"items":{"$ref":"#/$defs/valueSchema"}},
        "minimum":{"type":"number"},"maximum":{"type":"number"},
        "properties":{"type":"object","additionalProperties":{"$ref":"#/$defs/valueSchema"}},
        "required":{"type":"array","items":{"type":"string"},"uniqueItems":true},
        "additionalProperties":{"oneOf":[{"type":"boolean"},{"$ref":"#/$defs/valueSchema"}]},
        "items":{"$ref":"#/$defs/valueSchema"},"maxItems":{"type":"integer","minimum":0}
      }
    },
    "control": {
      "allOf":[{"$ref":"#/$defs/valueSchema"}],
      "type":"object","required":["id","label"],
      "properties":{"id":{"type":"string","minLength":1},"label":{"type":"string"},"clock":{"type":"string"}}
    },
    "state": {
      "type":"object",
      "required":["schemaVersion","visualId","revision","viewKey","stateVersion","definition","values","controls"],
      "properties": {
        "schemaVersion":{"const":"synth.visual-session.v1"},
        "visualId":{"type":"string","minLength":1},"revision":{"type":"integer","minimum":1},
        "viewKey":{"type":"string","minLength":1,"maxLength":200},"stateVersion":{"type":"integer","minimum":0},
        "definition":{"type":"object","required":["id","version"],"properties":{"id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"digest":{"type":"string"}}},
        "values":{"type":"object"},"controls":{"type":"array","maxItems":512,"items":{"$ref":"#/$defs/control"}},
        "scene":{"type":"object"},"evidenceCut":{"type":"object"},
        "replay":{"oneOf":[{"type":"object","required":["checkpointId"],"properties":{"checkpointId":{"type":"string","minLength":1}},"additionalProperties":false},{"type":"object","required":["recordingId","sequence"],"properties":{"recordingId":{"type":"string","minLength":1},"sequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"eventCount":{"type":"integer","minimum":0,"maximum":9007199254740991},"playing":{"type":"boolean"},"intervalMs":{"type":"integer","minimum":16,"maximum":60000}},"additionalProperties":false}]}
      },"additionalProperties":false
    },
    "checkpoint": {
      "type":"object","required":["schemaVersion","id","capturedAt","state","digest","renditionRefs"],
      "properties": {
        "schemaVersion":{"const":"synth.visual-checkpoint.v1"},"id":{"type":"string","minLength":1},
        "capturedAt":{"type":"string"},"state":{"$ref":"#/$defs/state"},
        "digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
        "renditionRefs":{"type":"array","items":{"type":"string"}}
      },"additionalProperties":false
    },
    "recording": {
      "type":"object","required":["schemaVersion","id","initial","events"],
      "properties": {
        "schemaVersion":{"const":"synth.visual-session-recording.v1"},"id":{"type":"string","minLength":1},
        "initial":{"$ref":"#/$defs/checkpoint"},"endedAt":{"type":"string"},
        "events":{"type":"array","items":{
          "type":"object","required":["sequence","action","state","occurredAt"],
          "properties":{
            "sequence":{"type":"integer","minimum":1},"occurredAt":{"type":"string"},"before":{"$ref":"#/$defs/state"},"state":{"$ref":"#/$defs/state"},
            "action":{"type":"object","required":["id","kind","expectedStateVersion","payload"],"properties":{"id":{"type":"string","minLength":1},"kind":{"enum":["presentation.set","presentation.patch"]},"expectedStateVersion":{"type":"integer","minimum":0},"payload":{"type":"object"}}}
          }
        }}
      },"additionalProperties":false
    }
  }
}
