# Synth Desktop runtime configuration.
# Copy to ~/.synth-desktop/config.toml. Secrets default to the adjacent .env
# file (created mode 0600 when saved from Desktop Settings).
#
# Workshop v0.2 instances should use an explicit lane profile. The dedicated
# Responses gateway is selected from checked-in Rust code and cannot be
# overridden here; unknown profiles fail closed for synth-cloud traffic.

[intern]
profile = "local-slot1" # local-slot1 | staging | production | local | prod
env_file = "~/.synth-desktop/.env"
api_key_env = "SYNTH_API_KEY"
worker_key_env = "SMR_WORKER_API_KEY" # internal Codex activity only

# Provider keys are loaded only from env_file. Workshop never copies them into
# Keychain or into optimizer/container processes.
[credentials.providers.openai]
variable = "OPENAI_API_KEY"

[credentials.providers.openrouter]
variable = "OPENROUTER_API_KEY"

[intern.endpoints]
local-slot1 = "http://127.0.0.1:41109"
staging = "https://api-dev.usesynth.ai"
production = "https://mcp.usesynth.ai"
# Legacy aliases still accepted:
prod = "https://api.usesynth.ai"
local = "http://127.0.0.1:8000"

# The first folder is the default cwd for new Codex conversations. All listed
# folders are available to Codex sessions using workspace-write.
# Configure these from Settings → Runtime → Agent workspace access.
[workspace]
allowed_roots = ["/Users/you/Documents/GitHub"]

# Project sources: folders Workshop may read `workshop.containers.toml`,
# `workshop.recipe.toml`, and `workshop.recipes/*.toml` from. Container commands
# declared in these folders can be started, after the usual execution approvals,
# so this is a stronger grant than [workspace] above -- name the exact
# repository, not a folder full of them.
#
# Normally written by Workshop, not by hand: an agent asks with
# `project_source_request`, the user confirms the same folder in a native
# picker, and Workshop records it here. Settings → Workspace → Project sources
# shows every entry and removes them.
#
# Discovery merges these with any non-empty SYNTH_CONTAINER_SOURCE_ROOTS /
# SYNTH_RECIPE_SOURCE_ROOTS override and with roots already discovered. Only
# when all three are empty does it fall back to scanning ~/GitHub.
# [[desktop.project_sources.entries]]
# path = "/Users/you/GitHub/nanohorizon"
# containers = true
# recipes = true
#
# Short form, granting both capabilities:
# [desktop.project_sources]
# roots = ["/Users/you/GitHub/nanohorizon"]

# Optional overrides for the provider-independent model presets shown in
# Desktop Settings. Omit an entry to use its built-in preset.
# [models.multi_agent]
# "gpt-5.6-sol" = "v2"
# "gpt-5.6-terra" = "v2"
# "gpt-5.6-luna" = "v1"
# "laguna-xs-2.1" = "none" # may be forced to "v1" or "v2"
# "laguna-s-2.1" = "none"

# ~/.synth-desktop/.env
# SYNTH_API_KEY=...

# Optional local inference / remote model settings:
# [laguna]
# base_url = "http://127.0.0.1:7333"
# [openrouter]
# api_key_env = "OPENROUTER_API_KEY"
