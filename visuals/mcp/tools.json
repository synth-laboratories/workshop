{
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Direct tool for Synth visuals; do not call MCP resources or search the filesystem. For a diagram, load author-synth-diagrams, create with arguments.content, show, then capture_review and examine its returned image before review. For ad-hoc data charts use operation \"chart\" (or the visual_chart tool): it writes the spec, renders it, and returns the PNG in one call.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "arguments": {
            "additionalProperties": true,
            "description": "capture_review requires visual_id and viewport {width,height}; it returns a PNG image and absolute screenshot_path.",
            "type": "object"
          },
          "operation": {
            "description": "Visual operation to run.",
            "enum": [
              "list_templates",
              "list",
              "get",
              "create",
              "update",
              "bind",
              "save",
              "show",
              "render",
              "capture_review",
              "chart",
              "authoring_context",
              "review",
              "mark_ready",
              "fork",
              "archive"
            ],
            "type": "string"
          }
        },
        "required": [
          "operation",
          "arguments"
        ],
        "type": "object"
      },
      "name": "visual_manage"
    },
