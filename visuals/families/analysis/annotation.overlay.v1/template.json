{
  "schemaVersion": "synth.visual-template.v1",
  "id": "annotation.overlay.v1",
  "title": "Annotation overlay",
  "genre": "annotation",
  "version": "1.0.0",
  "description": "Markers overlaid on a sealed Trace V5 — overlay only, never mutates the trace.",
  "accent": "#F05F22",
  "shell": "shell.tsx",
  "tags": [
    "annotation",
    "trace_v5",
    "overlay"
  ],
  "inputs": [
    {
      "name": "trace",
      "description": "Sealed Trace V5 reference (digest / id) — read-only",
      "accepts": [
        "trace_v5",
        "local_cas",
        "fixture"
      ],
      "required": true,
      "schema": "synth.trace.v5"
    },
    {
      "name": "annotations",
      "description": "Overlay markers (note/bug/highlight/reward/acceptance)",
      "accepts": [
        "fixture",
        "local_cas"
      ],
      "required": true,
      "schema": "synth.visual.annotation_markers.v1"
    }
  ]
}
