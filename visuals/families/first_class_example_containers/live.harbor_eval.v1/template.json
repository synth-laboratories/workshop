{
  "schemaVersion": "synth.visual-template.v1",
  "id": "live.harbor_eval.v1",
  "title": "Harbor eval live",
  "genre": "live",
  "family": "harbor",
  "version": "1.0.0",
  "description": "Harbor trial/verifier live view. Bind slot stream only.",
  "accent": "#FF5C00",
  "shell": "shell.tsx",
  "tags": [
    "live",
    "harbor",
    "eval",
    "job",
    "rollout"
  ],
  "observationContract": {
    "schemaVersion": "synth.visual-observation-contract.v1",
    "readiness": {
      "rejectTransportStates": [
        "idle",
        "declared",
        "replaying",
        "error",
        "connecting",
        "reconnecting"
      ],
      "minimumRolloutCount": 0,
      "minimumRenderedFrameCount": 0,
      "minimumSemanticEventCount": 1,
      "minimumTransportEnvelopeCount": 1,
      "requireTerminal": false
    }
  },
  "inputs": [
    {
      "name": "stream",
      "description": "Declared live SSE or fixture with trial/verifier events",
      "accepts": [
        "live_sse",
        "fixture",
        "inline"
      ],
      "required": true,
      "schema": "synth.trace-stream-event.v1"
    }
  ]
}
