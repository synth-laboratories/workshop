{
  "schemaVersion": "synth.visual-template.v1",
  "id": "live.container_rollouts.v1",
  "title": "Live container rollouts",
  "genre": "live",
  "version": "1.0.0",
  "description": "A live operational view of concurrent container eval rollouts: real step progress, rewards, achievements, vitals, usage, and recent engine activity.",
  "accent": "#FF5C00",
  "shell": "shell.tsx",
  "tags": [
    "live",
    "sse",
    "container",
    "eval",
    "rollout",
    "craftax"
  ],
  "observationContract": {
    "schemaVersion": "synth.visual-observation-contract.v1",
    "readiness": {
      "rejectTransportStates": [
        "idle",
        "declared",
        "replaying",
        "error",
        "connecting",
        "reconnecting"
      ],
      "minimumRolloutCount": 1,
      "minimumRenderedFrameCount": 0,
      "minimumSemanticEventCount": 1,
      "minimumTransportEnvelopeCount": 1,
      "requireTerminal": false
    }
  },
  "inputs": [
    {
      "name": "stream",
      "description": "A synth.rollout.event.v1 or evals.event-stream.v1 SSE endpoint or replay fixture",
      "accepts": [
        "live_sse",
        "fixture",
        "inline"
      ],
      "required": true,
      "schema": "synth.rollout.event.v1"
    }
  ]
}
