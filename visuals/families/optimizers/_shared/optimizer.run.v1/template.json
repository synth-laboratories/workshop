{
  "schemaVersion": "synth.visual-template.v1",
  "id": "optimizer.run.v1",
  "title": "Optimizer run",
  "genre": "optimizer",
  "version": "1.0.0",
  "description": "Shared optimizer chrome with GEPA / GELO / SFT / DAG overlays, historical scrub, and state slices.",
  "accent": "#F05F22",
  "shell": "shell.tsx",
  "tags": [
    "optimizer",
    "gepa",
    "go-ex",
    "sft",
    "dag",
    "timeline"
  ],
  "observationContract": {
    "schemaVersion": "synth.visual-observation-contract.v1",
    "readiness": {
      "rejectTransportStates": [
        "idle",
        "declared",
        "replaying",
        "error",
        "connecting",
        "reconnecting"
      ],
      "minimumRolloutCount": 0,
      "minimumRenderedFrameCount": 0,
      "minimumSemanticEventCount": 1,
      "requireTerminal": true
    }
  },
  "inputs": [
    {
      "name": "optimizer_run",
      "description": "Optimizer run id or inline run+events fixture payload",
      "accepts": [
        "optimizer_run",
        "fixture",
        "inline"
      ],
      "required": true,
      "schema": "optimizer_run.v1"
    }
  ]
}
