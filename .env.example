# Project-local Workshop credentials. Copy to .env (the installer does this
# when .env is absent) and keep the values private. Workshop's runtime copies
# only its allowlisted credentials into an isolated instance and exposes them
# to tools through the loopback secrets proxy.

# Synth account/API credential. Leave blank to use Workshop without Synth
# Cloud features.
SYNTH_API_KEY=

# Optional provider credential for OpenRouter-backed models.
OPENROUTER_API_KEY=
