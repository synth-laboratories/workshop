{
  "name": "@synth/synth-desktop",
  "version": "0.9.3",
  "private": true,
  "description": "Synth Workshop — local-first research engineering workbench",
  "type": "module",
  "scripts": {
    "dev": "../../scripts/desktop-instance.sh dev codex",
    "dev:instance": "../../scripts/desktop-instance.sh dev",
    "dev:verify": "../../scripts/desktop.sh verify",
    "dev:install": "../../scripts/desktop.sh install",
    "dev:restart": "../../scripts/desktop.sh restart",
    "build": "../../scripts/stage-mlx-runtime-distribution.sh && tauri build --config src-tauri/tauri.package.json",
    "frontend:dev": "vite --host 127.0.0.1",
    "frontend:build": "vite build",
    "package:prepare": "../../scripts/build-computer-use-helper.sh ensure-dev && npm run frontend:build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:app-css": "node scripts/lint-app-css.mjs",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:playwright": "playwright test --config playwright.config.ts",
    "test:ui-gates": "npm run lint:app-css && ../../scripts/desktop-ui-gates.sh",
    "test:ui-gates:bombadil": "../../scripts/desktop-ui-gates.sh bombadil",
    "test:ui-gates:playwright": "../../scripts/desktop-ui-gates.sh playwright",
    "test:bombadil": "npm run frontend:build && node tests/bombadil/run.mjs",
    "test:bombadil:alignment": "npm run frontend:build && BOMBADIL_SPEC=apps/synth_desktop/tests/bombadil/visual-alignment.spec.ts node tests/bombadil/run.mjs",
    "test:bombadil:side-panel-drag": "npm run frontend:build && BOMBADIL_SPEC=apps/synth_desktop/tests/bombadil/side-panel-composer-drag.spec.ts node tests/bombadil/run.mjs",
    "test:bombadil:composer-surfaces": "npm run frontend:build && BOMBADIL_SPEC=apps/synth_desktop/tests/bombadil/composer-surfaces.spec.ts node tests/bombadil/run.mjs",
    "test:bombadil:launch-debt": "npm run frontend:build && BOMBADIL_SPEC=apps/synth_desktop/tests/bombadil/launch-debt.spec.ts node tests/bombadil/run.mjs",
    "test:bombadil:reasoning": "npm run frontend:build && BOMBADIL_SPEC=apps/synth_desktop/tests/bombadil/reasoning-disclosure.spec.ts node tests/bombadil/run.mjs",
    "test:bombadil:empty-turn": "npm run frontend:build && BOMBADIL_SPEC=apps/synth_desktop/tests/bombadil/empty-completed-turn.spec.ts node tests/bombadil/run.mjs",
    "test:bombadil:composer-toolbar": "npm run frontend:build && BOMBADIL_SPEC=apps/synth_desktop/tests/bombadil/composer-toolbar.spec.ts node tests/bombadil/run.mjs",
    "test:bombadil:terminal": "npm run frontend:build && BOMBADIL_SPEC=apps/synth_desktop/tests/bombadil/terminal-polish.spec.ts node tests/bombadil/run.mjs",
    "test:bombadil:v0.1-visuals": "npm run frontend:build && BOMBADIL_SPEC=apps/synth_desktop/tests/bombadil/v0.1-visual-contracts.spec.ts node tests/bombadil/run.mjs",
    "test:bombadil:approval": "npm run frontend:build && BOMBADIL_SPEC=apps/synth_desktop/tests/bombadil/approval-card.spec.ts node tests/bombadil/run.mjs",
    "test:bombadil:grouped-visual": "npm run frontend:build && BOMBADIL_SPEC=apps/synth_desktop/tests/bombadil/grouped-visual-evidence.spec.ts node tests/bombadil/run.mjs",
    "test:bombadil:min-width": "npm run frontend:build && BOMBADIL_SPEC=apps/synth_desktop/tests/bombadil/minimum-width-replay.spec.ts node tests/bombadil/run.mjs",
    "test:bombadil:mander": "npm run frontend:build && BOMBADIL_SPEC=apps/synth_desktop/tests/bombadil/mander-boundaries.spec.ts node tests/bombadil/run.mjs",
    "test:bombadil:visual-library": "npm run frontend:build && BOMBADIL_SPEC=apps/synth_desktop/tests/bombadil/visual-library-layout.spec.ts node tests/bombadil/run.mjs"
  },
  "dependencies": {
    "@synth/runtime-protocol": "*",
    "@synth/visuals": "*",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@antithesishq/bombadil": "^0.7.2",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.6"
  }
}
