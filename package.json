{
  "name": "synth-workshop",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "visuals"
  ],
  "scripts": {
    "build:graph": "turbo run frontend:build --filter=@synth/synth-desktop",
    "check:graph": "turbo run typecheck",
    "build": "./scripts/workshop.sh build",
    "typecheck": "npm run typecheck --workspace @synth/synth-desktop",
    "workshop": "cargo run --manifest-path apps/synth_desktop/src-tauri/Cargo.toml --bin workshop --",
    "mcp:visuals": "cargo run --manifest-path apps/synth_desktop/src-tauri/Cargo.toml --bin synth-visuals-mcp",
    "laguna:setup": "./scripts/laguna/setup.sh",
    "laguna:serve": "./scripts/laguna/serve.sh",
    "desktop:build": "./scripts/workshop.sh build",
    "desktop:run": "./scripts/workshop.sh run",
    "desktop:build-and-run": "./scripts/workshop.sh build-and-run"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "allowScripts": {
    "electron@41.10.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@openai/codex": "0.153.0",
    "turbo": "^2.10.9"
  }
}
